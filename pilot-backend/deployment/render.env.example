# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# Only the project publishable key; never service_role or a DB password.
PILOT_SUPABASE_PUBLIC_KEY=sb_publishable_REPLACE_IN_RENDER
# Optional exact assigned origin; default is RENDER_EXTERNAL_URL.
# PILOT_PUBLIC_ORIGIN=https://assigned-name.onrender.com
# No flags enable writes. No database credentials required.
